# =====================================================
# 智愈寻真 - 环境变量样例
# 复制本文件为 .env 后再修改真实值（不要把 .env 提交到 git）
# =====================================================

# ---- 环境 ----
COMPOSE_PROJECT_NAME=zhiyu
ENV_MODE=dev

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=zhiyu_db
MYSQL_PORT=13306

# ---- Redis ----
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Milvus ----
MILVUS_PORT=19530

# ---- 后端 Spring Boot ----
BACKEND_PORT=8080
SPRING_PROFILE=dev
JWT_SECRET=please-change-me-to-a-random-32-char-string
JWT_EXPIRE_HOURS=24

# ---- AI 中台 FastAPI ----
AI_PORT=8000
# 科大讯飞星火 Spark Max（去 https://console.xfyun.cn 申请）
SPARK_APP_ID=
SPARK_API_KEY=
SPARK_API_SECRET=
# 星火多模态 Spark Vision
SPARK_VISION_APP_ID=
SPARK_VISION_API_KEY=
SPARK_VISION_API_SECRET=

# ---- 前端 Vue ----
FRONT_PORT=5173
# 前端在浏览器中访问后端的基地址（开发期通过 Vite proxy，生产期指向域名）
VITE_API_BASE=http://localhost:8080
VITE_AI_BASE=http://localhost:8000

# ---- 生产环境专用(开发时忽略) ----
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443
# DOMAIN=zhiyu.example.com
