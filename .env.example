# =====================================================
# 智愈寻真 - 环境变量样例
# 复制本文件为 .env 后再修改真实值（不要把 .env 提交到 git）
# =====================================================

# ---- 环境 ----
COMPOSE_PROJECT_NAME=zhiyu
ENV_MODE=dev

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=zhiyu_db
MYSQL_PORT=13306

# ---- Redis ----
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Milvus ----
MILVUS_PORT=19530

# ---- 后端 Spring Boot ----
BACKEND_PORT=8080
# 必须设置：dev 本地开发 / test 测试 / prod 生产
SPRING_PROFILES_ACTIVE=dev
# 演示数据开关：dev 默认 true（创建 admin01/teacher01/student01），prod 必须为 false
DEMO_DATA=true
# JWT 密钥：开发环境留空将使用 application-dev.yml 内置 dev 密钥
# 生产环境必须设置随机 32 字节强密钥（可用 openssl rand -base64 32 生成）
JWT_SECRET=
JWT_EXPIRE_HOURS=24
# 短信供应商。开发期留空即可使用内置开发验证码；生产环境必须接入供应商后填写。
SMS_PROVIDER=
# Java 端 CORS 白名单：逗号分隔字符串（注意：与 AI 端格式不同）
# 开发环境留空使用通配符 *；生产环境必须设置明确的 Origin
# 例：CORS_ALLOWED_ORIGINS=https://admin.example.com,https://teacher.example.com
CORS_ALLOWED_ORIGINS=

# ---- AI 中台 FastAPI ----
AI_PORT=8000
# 环境模式（dev 输出 DEBUG 日志，prod 输出 INFO 日志）
ENV_MODE=dev

# ===== 大模型（OpenAI 兼容协议）=====
# 可先留空；开发环境会明确标记为 degraded，生产环境必须配置真实模型并关闭 fallback
# 星火 OpenAI 兼容端点：https://spark-api-open.xf-yun.com/v1
# 通义千问：https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek：https://api.deepseek.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=generalv3.5
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7

# ===== 多模态大模型（Vision）=====
# 星火多模态 OpenAI 兼容端点：https://spark-api-open.xf-yun.com/v1
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=4.0VImage

# ===== Embedding 服务（OpenAI 兼容）=====
# 星火 embedding：https://spark-api-open.xf-yun.com/v1，模型 embedding-v1
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embedding-v1

# ===== Milvus =====
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=zhiyu_textbook
MILVUS_VECTOR_DIM=1024

# ===== Redis（可选，预留）=====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== 内部 token（必须与 Java 后端 zhiyu.ai.internal-token 一致）=====
# 开发环境留空将使用 config.py / application.yml 内置 dev token
# 生产环境必须替换为随机 token，否则 AI 中台 validate_prod 会拒绝启动
AI_INTERNAL_TOKEN=
OPS_TOKEN=

# Vision 图片来源白名单。生产环境必须填写，例如：storage.example.com
VISION_ALLOWED_HOSTS=[]

# AI 端 CORS 白名单：JSON 数组格式（注意：与 Java 端格式不同）
# 开发环境留空使用空列表；生产环境必须设置明确的 Origin，不允许通配符
# 例：AI_CORS_ALLOWED_ORIGINS=["https://admin.example.com","https://teacher.example.com"]
AI_CORS_ALLOWED_ORIGINS=[]

# 开发环境受控对象目录；教材任务只接受该目录下的 objectKey
OBJECT_STORAGE_ROOT=./data/objects
OBJECT_STORAGE_MAX_BYTES=52428800
AI_WORKER_TYPES=review,report,knowledge_ingest
AI_WORKER_POLL_SECONDS=1

# ===== 业务中台回调地址（容器内网络）=====
BACKEND_CALLBACK_URL=http://backend:8080

# ===== 降级开关 =====
# 开发环境可设为 true 使用规则 mock 兜底；生产环境必须为 false（config.py validate_prod 会拒绝）
ENABLE_LLM_FALLBACK=false
ENABLE_MILVUS_FALLBACK=false

# 以下为兼容旧版变量（docker-compose 仍引用），保留但不再使用
# 科大讯飞星火 Spark Max（去 https://console.xfyun.cn 申请）
SPARK_APP_ID=
SPARK_API_KEY=
SPARK_API_SECRET=
# 星火多模态 Spark Vision
SPARK_VISION_APP_ID=
SPARK_VISION_API_KEY=
SPARK_VISION_API_SECRET=

# ---- 前端 Vue ----
FRONT_PORT=5173
# 前端在浏览器中访问后端的基地址（开发期通过 Vite proxy，生产期指向域名）
VITE_API_BASE=http://localhost:8080
VITE_AI_BASE=http://localhost:8000

# ---- 生产环境专用(开发时忽略) ----
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443
# DOMAIN=zhiyu.example.com
#
# 生产环境必须设置的 CORS（两个变量格式不同，不可混用）：
#   CORS_ALLOWED_ORIGINS      → Java 端，逗号分隔字符串
#     例：https://admin.example.com,https://teacher.example.com
#   AI_CORS_ALLOWED_ORIGINS   → AI 端，JSON 数组
#     例：["https://admin.example.com","https://teacher.example.com"]
